.DS_Store
node_modules/
dist/
# Databricks Apps does not run `npm run build`, so the compiled frontend has to be
# committed for the App to have anything to serve. Re-including the directory is
# what makes this work: git will not re-include a file whose parent directory is
# excluded, so `!frontend/dist/**` alone would do nothing. node_modules/ stays
# ignored above and is never traversed, so no dependency dist/ folders leak in.
!frontend/dist/
.venv/
__pycache__/
*.py[cod]
*.db
backend/uploads/*
!backend/uploads/.gitkeep
backend/.env
frontend/.env

.gstack/
