# Local development only. In a deployed Databricks App there is no .env file —
# configuration arrives as real environment variables from app.yaml and from the
# attached Lakebase resource, and config.py falls through to the process
# environment when this file is absent.

COVERBASE_MODE=mock
COVERBASE_BASE_URL=https://api.coverbase.app
COVERBASE_API_KEY=replace-with-your-coverbase-api-key
COVERBASE_QUESTIONNAIRE_ID=replace-with-your-coverbase-questionnaire-id
UPLOAD_DIR=./uploads
HAZEL_DEV_MODE=false

# Shared secret that authenticates the Azure backend-for-frontend. Every /api
# route requires it, including locally: with it unset the API answers 503 rather
# than defaulting open. Send it as the X-Hazel-Proxy-Key header.
HAZEL_PROXY_KEY=replace-with-a-long-random-string

# GET {RAFA_BASE_URL}/banks/{fdic_cert_number}, authenticated with x-api-key.
RAFA_BASE_URL=https://bank-profile-proxy.onrender.com
RAFA_API_KEY=replace-with-your-rafa-api-key
# Temporary local testing threshold; replace when Hazel approves production policy.
#
# NOTE the direction. RAFA composite_score is a CAMELS-style rating where LOWER is
# better — JPMorgan Chase scores 1.85, and the scale runs 1 (strongest) to 5. But
# normalize_bank() accepts when `score >= minimum_score`, so raising this value
# accepts *weaker* banks, and 3 accepts almost nothing: every institution sampled
# from this feed scores under 2.1. Verify against real certificates before trusting
# an eligibility result.
RAFA_ELIGIBILITY_MIN_SCORE=3
# Keep the working OnRender integration available; use databricks for App URL lookup.
RAFA_PROVIDER=onrender
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_CLIENT_ID=replace-with-your-service-principal-client-id
DATABRICKS_CLIENT_SECRET=replace-with-your-service-principal-client-secret
DATABRICKS_APP_URL=https://your-app.aws.databricksapps.com

# Lakebase. In the App these five are injected by the attached Lakebase project
# resource and ENDPOINT_NAME comes from app.yaml; none of them are read from this
# file there. Set all six here only to run `python backend/migrate.py` from a
# workstation. Copy the values from the resource — never assemble them by hand,
# because a host that disagrees with the real endpoint fails silently.
# PGHOST=
# PGPORT=5432
# PGDATABASE=databricks_postgres
# PGUSER=
# PGSSLMODE=require
# ENDPOINT_NAME=projects/hazel-hop-lakebase/branches/production/endpoints/primary

# Removed deliberately:
#   DATABASE_PATH   — SQLite is gone; data lives in Lakebase Postgres.
#   FRONTEND_ORIGIN — the UI is hosted on Azure and reaches this API through a
#                     server-side proxy, so no CORS middleware is registered.
