# Origin this app sends /api/public/* to. In deployment that is the Render BFF,
# which forwards to the Databricks API. Required: the build fails if it is unset
# (scripts/check-env.mjs). Empty means same-origin.
VITE_API_BASE_URL=http://localhost:8000

# Prefills the form with test values and reveals the local dev handoff below.
# Gated by import.meta.env.DEV as well, so it has no effect on a production build.
VITE_DEV_MODE=false

# Where to send the developer after a successful eligible inquiry, for the
# dev-only "open NDA" shortcut. The API returns next_path as /case/{id}/nda,
# which belongs to the member portal — a different app on a different origin —
# so this is prepended and the browser navigates there.
#
# Optional. Production never reads it: its only caller is behind DEV_MODE and is
# stripped from a production build. Set it to wherever the member portal runs
# locally, e.g. http://localhost:5174.
VITE_MEMBER_PORTAL_URL=
