# Origin this app sends /api/public/* to. In deployment that is the Render BFF,
# which forwards to the Databricks API. Required: the build fails if it is unset
# (scripts/check-env.mjs). Empty means same-origin.
VITE_API_BASE_URL=http://localhost:8000

# Prefills the form with test values and reveals the local dev handoff below.
# Gated by import.meta.env.DEV as well, so it has no effect on a production build.
VITE_DEV_MODE=false

# Member portal used by production Sign In and the explicit development-only
# eligible onboarding handoff. A local pair can override this with
# http://localhost:5174.
VITE_MEMBER_PORTAL_URL=https://member-portal-c4k9.onrender.com
