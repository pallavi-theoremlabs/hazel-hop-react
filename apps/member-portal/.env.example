# Shared BFF. Render production should set this to
# https://hazel-hop-react.onrender.com; local development commonly uses 8000.
VITE_API_BASE_URL=http://localhost:8000

# The temporary tenant context requires BOTH an explicit development/test
# environment and VITE_DEV_MODE=true. These safe defaults keep it closed.
VITE_HAZEL_ENVIRONMENT=production
VITE_DEV_MODE=false
