# Databricks workspace and Hazel API app. Keep client credentials server-side.
DATABRICKS_HOST=https://dbc-<workspace-id>.cloud.databricks.com
DATABRICKS_APP_URL=https://<hazel-api-app>.databricksapps.com
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Must exactly match HAZEL_PROXY_KEY on the Databricks Hazel API app.
HAZEL_PROXY_KEY=

# Explicit browser-origin allowlist. Comma-separated; no paths or trailing slash.
# The historical singular FRONTEND_ORIGIN remains supported as a fallback.
FRONTEND_ORIGINS=https://frontend-hop.onrender.com,https://member-portal-c4k9.onrender.com
